# Required to actually run investigations end to end. Without this set,
# E2BExecutionBackend fails loudly at startup rather than falling back to
# running code unsandboxed on the host. Get a key at https://e2b.dev.
E2B_API_KEY=

# Optional. Defaults to a local SQLite file (sqlite:///./bug_hunt.db) if unset.
# Models avoid SQLite-only column types, so pointing this at a Postgres
# connection string instead is a drop-in swap.
DATABASE_URL=
